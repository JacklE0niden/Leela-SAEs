# In-memory Mongo lets circuit tracing run without a database. Set false and
# configure MONGO_URI for persistent Features, Dictionaries, and Bookmarks.
MONGO_MOCK=true
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=mechinterp
SAE_SERIES=default

# Repository-relative defaults. Change these values when your files live elsewhere.
LC0_BT4_CHECKPOINT=models/lc0/BT4.pt
BT4_SAE_ROOT=result_BT4
PRELOAD_CIRCUIT_MODELS=false

# Optional paths used by secondary workflows:
# CHESS_DATASET_PATH=data/chess_master_data
# STOCKFISH_PATH=stockfish
# BT4_ACTIVATION_ROOT=activations/BT4
# LC0_T82_CHECKPOINT=models/lc0/T82.pt
# SEARCHLESS_CHESS_MODEL_ROOT=models/searchless_chess
# SEARCHLESS_CHESS_CHECKPOINT=models/searchless_chess/checkpoints/270M_torch/searchless_chess.pt
# SEARCHLESS_CHESS_BEHAVIORAL_CHECKPOINT=models/searchless_chess/checkpoints/9M_behavioral_cloning_torch/behavioral_cloning_params.pt
